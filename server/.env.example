# ---------------------------------------------------------------------------
# Configuration du proxy ServiceNow.
# Copier ce fichier vers server/.env puis remplir les valeurs.
# Ce fichier-ci est un modèle : il ne doit contenir AUCUN secret réel.
# ---------------------------------------------------------------------------

# URL de l'instance, sans slash final.
SN_INSTANCE=https://devXXXXXX.service-now.com

# Mode d'authentification : "oauth" (recommandé) ou "basic".
SN_AUTH=oauth

# Type de grant OAuth : "password" ou "client_credentials".
SN_GRANT=password

# Identifiants de l'application OAuth
# (ServiceNow : System OAuth > Application Registry > votre application).
SN_CLIENT_ID=
SN_CLIENT_SECRET=

# Compte de service utilisé par le proxy (requis avec SN_GRANT=password).
SN_USER=
SN_PASSWORD=

# Port d'écoute du proxy. Le client Vite y renvoie /api par défaut.
PORT=3001
